10 DEFINT A-Z
20 DEFDBL D
30 DIM A(240)
40 S = 0 : T0 = 0 : T1 = 0 : D0 = 0
50 I = 0 : D = 0 : X$ = ""
60 I = 0
70 READ D
80 IF D = -1 THEN 120
90 POKE VARPTR(A(0)) + I, D
100 I = I + 1
110 GOTO 70
120 PRINT "Loaded "; I; " bytes. Press Enter to CALL..."
130 INPUT X$
140 O = VARPTR(A(0))
150 CALL O
160 PRINT "RETURNED OK"
170 S = PEEK(VARPTR(A(0)) + 128)
180 T0 = PEEK(VARPTR(A(0)) + 130) + 256! * PEEK(VARPTR(A(0)) + 131)
190 T1 = PEEK(VARPTR(A(0)) + 132) + 256! * PEEK(VARPTR(A(0)) + 133)
200 D0 = T0 - T1
210 IF D0 < 0 THEN D0 = D0 + 65536!
220 PRINT "status="; S
230 PRINT "t0="; T0; "  t1="; T1
240 PRINT "dCH0="; D0
250 END
